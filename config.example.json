{
  "ffmpeg": "ffmpeg",
  "ffprobe": "ffprobe",
  "device": "cuda",
  "cpu_threads": 8,
  "batch_size": 16,
  "chunk_seconds": 30,
  "beam_size": 5,
  "whisper_compute_type": "float16",
  "whisper_vad": false,
  "command_timeout": 14400,
  "offline": true,
  "models": {
    "whisper": "models/whisper-turbo",
    "qwen": "models/qwen-asr",
    "aligner": "models/forced-aligner",
    "vision": "models/internvl"
  },
  "speaker_cache": "models/speaker-cache",
  "translation": {
    "url": "http://127.0.0.1:5127/v1/chat/completions",
    "model": "local-translator",
    "timeout": 240
  }
}
